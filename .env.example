# BrandShield AI - Environment Configuration Example
# Copy this file to .env and configure your API keys.
# NEVER commit .env to GitHub or share API keys publicly.

# VirusTotal API v3 Key (Used for URL and domain threat intelligence reputation checks)
# Free public API registration: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Gemini API Key (Optional: for AI explanation of suspicious profile bios)
# Free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key
FLASK_SECRET_KEY=brandshield-ai-production-secret-key-change-me

# Supabase PostgreSQL Database Credentials
# Obtain from Supabase Project Settings -> API (Project URL & anon/service_role key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_api_or_service_role_key_here
